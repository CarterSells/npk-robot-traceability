# For local development run npm run db:setup; see docs/local-supabase.md.
# Dedicated staging project for hosted verification. Never prefix these with NEXT_PUBLIC_.
BETA_ENABLED=false
# Enable only after the B2 migration; cut over each organization with cutover_history.
BETA_HISTORY_ENABLED=false
# Enable lifecycle after B3 migration. Google additionally requires provider/redirect setup.
BETA_AUTH_LIFECYCLE=false
BETA_GOOGLE_ENABLED=false
BETA_PROJECTS_ENABLED=false
# Enable only after the additive B5 migration and synthetic verification.
BETA_MACHINES_ENABLED=false
# B6 remains off until its additive migration and acceptance checks pass.
BETA_LIFECYCLE_ENABLED=false
BETA_PORTAL_ENABLED=false
# B10 simulation-only API. Enable after additive schema and synthetic verification.
BETA_COMMANDS_ENABLED=false
# B11 report publication and service retrieval. Webhook worker uses CONNECTOR_KEYS.
BETA_REPORTS_ENABLED=false
# Comma-separated exact approved destination hostnames. Empty blocks all delivery.
REPORT_WEBHOOK_HOSTS=
# Activate only after the B8 schema and synthetic local acceptance.
BETA_CONNECTORS_ENABLED=false
# No provider secret is ever NEXT_PUBLIC_. Configure through the secret manager.
ONSHAPE_CLIENT_ID=
ONSHAPE_CLIENT_SECRET=
# JSON object mapping key IDs to 32-byte lowercase hex keys; retain old keys during rotation.
CONNECTOR_KEYS=
CONNECTOR_ACTIVE_KEY=
# Optional JSON array of company-configured primary/secondary webhook signing keys.
ONSHAPE_WEBHOOK_KEYS=
BETA_ORIGIN=http://127.0.0.1:3002
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
