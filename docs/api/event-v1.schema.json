{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unify:event:1",
  "title": "Tavrik approved run event v1",
  "description": "Maximum UTF-8 body: 2097152 bytes. Capture structure is additionally validated by the existing Tavrik record validator; cross-field relationships, provenance and units cannot be established by this envelope schema alone.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "schema_version", "run_id", "source_identity", "source_sequence", "observed_at", "event_type", "payload"],
  "properties": {
    "event_id": {"$ref": "#/$defs/uuid"},
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,119}$"},
    "source_identity": {"$ref": "#/$defs/uuid"},
    "source_sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "observed_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "event_type": {"enum": ["run.recorded", "execution.recorded"]},
    "payload": {"type":"object"}
  },
  "allOf": [{"if":{"properties":{"event_type":{"const":"run.recorded"}}},"then":{"properties":{"payload":{"type":"object","additionalProperties":false,"required":["capture"],"properties":{"capture":{"$ref":"#/$defs/capture"}}}}},"else":{"properties":{"run_id":{"$ref":"#/$defs/uuid"},"payload":{"$ref":"./execution-v1.schema.json"}}}}],
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"},
    "capture": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "version", "synthetic", "records", "corrections"],
      "properties": {
        "format": {"const": "unify-local"}, "version": {"enum": [1, 2]}, "synthetic": {"type": "boolean"},
        "corrections": {"type": "array", "maxItems": 0},
        "mappings": {"type": "array", "maxItems": 1000, "items": {"type": "object"}}, "investigations": {"type": "array", "maxItems": 0},
        "records": {
          "type": "object", "additionalProperties": false, "required": ["robots", "snapshots", "runs"],
          "properties": {
            "robots": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object"}},
            "snapshots": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object"}},
            "runs": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object"}}
          }
        }
      }
    }
  }
}
